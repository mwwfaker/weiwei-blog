# 依赖与构建产物
node_modules/
frontend/dist/
frontend/ssr-smoke/dist-ssr/

# 已停用的 Java 后端（归档在 legacy/）的构建产物
legacy/backend/target/

# 无头浏览器截图的工作目录：用来人工核对视觉效果，不参与构建，也没必要进版本库
shots/

# 临时校验目录（重构/审计时用，跑完就该删）
.audit/
frontend/.verify-*/

# 写提交信息用的临时文件。`git add -A` 会顺手把它加进去（924db78 就发生过一次），
# 提交完再删就变成「已提交但工作区已删除」，所以直接挡住。
.msg.txt
.commit-msg.txt
*.commitmsg

# 无头浏览器探针页面：为了同源测量临时放进 public/，验证完必须删；
# 万一忘了删，至少别让它进版本库（它会被原样拷进 dist）。
frontend/public/__probe*.html

# 本地环境变量：每个人各自配置，不进版本库（`.env` 只匹配同名文件，
# 所以 .env.local / .env.*.local 要单独列出来，否则会被提交上去）
.env
.env.local
.env.*.local
.DS_Store
Thumbs.db

supabase/.temp/
