# 公网部署环境变量模板。复制成自己的密码管理器条目，不要把填好的值提交进仓库。
# 变量名与 backend/src/main/resources/application.yml 一一对应。

# ---- 数据库（免费云 MySQL / MySQL 兼容）----
# 云数据库基本都强制 TLS，连接串里必须带 sslMode：
#   能提供 CA 证书时：sslMode=VERIFY_IDENTITY
#   只要求加密通道： sslMode=REQUIRED
# TiDB Cloud Serverless 端口是 4000，Aiven / 自建 MySQL 是 3306。
DB_URL=jdbc:mysql://<数据库主机>:<端口>/weiwei_blog?sslMode=REQUIRED&enforceTLS=true&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=<数据库用户名>
DB_PASSWORD=<数据库密码>

# 注意：库表由 Flyway 自动建立，不要手工执行 db/schema.sql。
# 如果目标库里已经有别的表，Flyway 会因为「非空但没有历史表」而拒绝启动。

# ---- 登录令牌密钥 ----
# 必填，至少 32 个 UTF-8 字节（大约 16 个汉字或 32 个英文字符）。
# 生成一个：  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 这个值一旦更换，所有人已登录的令牌立即失效。丢失则无法校验旧令牌。
APP_JWT_SECRET=<至少32字节的随机串>

# ---- 允许跨域的前端来源 ----
# 多个来源用英文逗号分隔，不要带结尾斜杠，也不要带路径。
# GitHub Pages 的 origin 是 https://<用户名>.github.io（不含仓库名）。
CORS_ORIGIN=https://<用户名>.github.io,http://localhost:5173

# ---- 对象存储（S3 兼容：Cloudflare R2 / Backblaze B2 / MinIO 均可）----
# R2：endpoint 形如 https://<accountid>.r2.cloudflarestorage.com，region 填 auto。
S3_ENDPOINT=https://<账号ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=weiwei-media
S3_ACCESS_KEY=<Access Key ID>
S3_SECRET_KEY=<Secret Access Key>

# ---- 前端构建期变量（放在 GitHub 仓库 Variables 里，不是 Secrets）----
# 仓库 Settings → Secrets and variables → Actions → Variables：
#   VITE_API_BASE_URL = https://<你的后端域名>
# 改动后需要重新触发一次 Pages 构建才会生效。
