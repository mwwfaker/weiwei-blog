{
  "name": "weiwei-blog-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-frontend.mjs",
    "verify:lyrics": "node scripts/verify-lyrics.mjs",
    "verify:perf": "node scripts/verify-perf.mjs",
    "verify:ocr": "node scripts/verify-ocr.mjs",
    "verify:diary": "node scripts/verify-diary-import.mjs",
    "verify:article": "node scripts/verify-article-import.mjs",
    "verify:supabase": "node verify-supabase.mjs",
    "verify:all": "npm run verify && npm run verify:lyrics && npm run verify:perf && npm run verify:ocr && npm run verify:diary && npm run verify:article",
    "new:page": "node scripts/new-page.mjs",
    "test:render": "vite build --ssr ssr-smoke/entry.js --outDir ssr-smoke/dist-ssr --logLevel warn && node ssr-smoke/run.mjs",
    "test": "npm run verify:all && npm run test:render"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.78.0",
    "@vueuse/core": "^14.4.0",
    "exifr": "^7.1.3",
    "mammoth": "^1.9.1",
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "vue": "3.5.43",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
