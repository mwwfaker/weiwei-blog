# 前端环境变量模板。复制成 `.env.local` 再填（`.env.local` 已在 .gitignore 里）。
#
# Vite 只会把 `VITE_` 开头的变量注入前端代码，所以这三个名字都是 VITE_ 前缀。
# 三个都可以留空：留空时前端进入「本机预览模式」，数据只留在这个浏览器里，
# 不会去连任何后端（见 frontend/src/services/api.js 的 backendConfigured）。

# Supabase 项目的 URL 与 anon（publishable）key。
# 这两个值**设计上就是公开的**：它们会被打进前端产物，任何人都能看到。
# 真正的访问控制在数据库的 RLS 策略里（supabase/schema.sql），不在前端。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 可选：中文歌词源的中转地址。
# 那个歌词站不带跨域响应头，浏览器直连会被拦；仓库里附了一个 Supabase Edge Function
# 的实现（supabase/functions/lyrics/），部署后把它的地址填在这里。
# 不填也能用：自动匹配会退到 LRCLIB，再加上手动粘贴歌词。
VITE_LYRICS_PROXY=

# 可选：立体浏览的深度模型放在哪。
# 不填 = 从 HuggingFace 取（国内慢）。搬到自己的对象存储后就填下面两条：
#   VITE_DEPTH_MODEL_HOST=https://<项目>.supabase.co/storage/v1/object/public/weiwei-assets/models
#   VITE_DEPTH_MODEL_PATH_TEMPLATE={model}/{file}
# 换镜像站（目录形状和 HuggingFace 一样）时只填第一行：
#   VITE_DEPTH_MODEL_HOST=https://hf-mirror.com
# 路径模板的默认值是 `{model}/resolve/main/`，也就是 HuggingFace 的形状。
VITE_DEPTH_MODEL_HOST=
VITE_DEPTH_MODEL_PATH_TEMPLATE=
